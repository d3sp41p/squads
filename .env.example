# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values.

# Supabase → Connect → Transaction pooler (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Any long random string, e.g. the output of: openssl rand -base64 32
SESSION_SECRET=

# https://www.solanatracker.io/data-api → API key
SOLANATRACKER_API_KEY=

# Any long random string. Vercel sends it to /api/cron automatically.
CRON_SECRET=

# Wallets refreshed per cron run (optional)
PNL_REFRESH_BATCH=40
